#!/usr/bin/env python3
"""Coordinator chat: an interactive session using the configured Producer CLI."""
import json
import os
import subprocess
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, here)
import teamcfg  # noqa: E402

cfg = teamcfg.load()
producer, name = cfg["roles"]["producer"], cfg["project"]["name"]
os.environ["TEAM_CONFIG"] = cfg["config_path"]
os.environ["PATH"] = os.path.join(here, "bin") + os.pathsep + os.environ.get("PATH", "")
os.chdir(cfg["root"])
skill = os.path.join(os.path.dirname(here), ".agents", "skills", "team-setup", "SKILL.md")
prompt = (teamcfg.template(cfg, "roles/coordinator.md").replace("{project}", name)
          .replace("{state_dir}", cfg["project"]["state_dir"]).replace("{config}", cfg["config_path"])
          .replace("{team_setup}", skill))
if not cfg["project"]["team_setup"]:  # never tailored: offer the setup before anything else
    prompt += ("\n\nFirst message: team setup has not been run in this workspace ([project].team_setup is empty in "
               f"{cfg['config_path']}). Whatever the user's first message says, do not answer it yet. Reply only with: "
               "\"You have not ran `team-setup` in this workspace, do you want to do that now?\" and the options Yes and "
               "No (in Claude Code ask with the AskUserQuestion tool; in Codex use request_user_input when available, "
               f"otherwise list the two options and wait). Yes: follow {skill}, then come back to the first message. "
               "No: answer the first message as usual.")
if producer["cli"] == "codex":
    # `team` starts agents that need network and write outside the project (journal, CLI state): a sandboxed
    # coordinator cannot run it. Approvals still follow the user's Codex config; agents get their own sandbox.
    argv = ["codex", "-s", "danger-full-access", "--model", producer["model"], "-c", f'model_reasoning_effort="{producer["effort"]}"',
            "-c", f"developer_instructions={json.dumps(prompt)}"]
else:
    argv = ["claude", "--model", producer["model"], "--effort", producer["effort"], "-n", f"{name} team",
            "--append-system-prompt", prompt]
argv = teamcfg.command(argv + sys.argv[1:])
if os.name == "nt":  # exec on Windows starts a new process and returns at once; wait to keep the exit code
    sys.exit(subprocess.run(argv).returncode)
os.execvp(argv[0], argv)

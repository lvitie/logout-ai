// Rendered by team-up (bin/team-up) into <state_dir>/team.kdl; @@AGENT_TEAM@@ is the agent-team directory.
// Panes inherit TEAM_CONFIG and the project root as working directory.
layout {
    pane split_direction="vertical" {
        pane split_direction="horizontal" size="55%" {
            pane size=12 split_direction="vertical" {
                pane name="usage" command="@@AGENT_TEAM@@/usage_tui"
                pane size="42%" name="focus" command="@@AGENT_TEAM@@/focus_tui"
            }
            pane name="live log" command="@@AGENT_TEAM@@/log_tui"
        }
        pane split_direction="horizontal" {
            pane size="40%" name="tasks" command="@@AGENT_TEAM@@/tasks_tui"
            pane name="coordinator" focus=true command="@@AGENT_TEAM@@/chat"
        }
    }
}

#!/usr/bin/env python3
"""Claude Code statusLine command: dumps rate_limits to a cache file for the team usage panel, prints a short status."""
import json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import teamcfg
d = json.load(sys.stdin)
rl = d.get("rate_limits") or {}
if rl:
    p = str(teamcfg.claude_rate_file())
    json.dump(rl, open(p + ".tmp", "w")); os.replace(p + ".tmp", p)
f = (rl.get("five_hour") or {}).get("used_percentage"); w = (rl.get("seven_day") or {}).get("used_percentage")
print(f"{d.get('model', {}).get('display_name', '')}" + (f" · 5h {f:.0f}% · 7d {w:.0f}%" if f is not None and w is not None else ""))

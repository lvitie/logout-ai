#!/usr/bin/env python3
"""Dashboard "alerts" pane: when a task needs the user (gate, blocked, escalated, failed, stale, slow, held; the
events of `team wait`) or is done, pops a desktop notification and opens the HTML review page for it. Tasks already in
such a state when it starts are reported once (done ones are not). Each pass also runs the queue (`team queue`): queued tasks start as capacity frees up.
--once checks a single time and exits."""
import os
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import team  # noqa: E402
import teamcfg  # noqa: E402

CFG = teamcfg.load()
team.init()
NAME, N = CFG["project"]["name"], CFG["notify"]
QUIET = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}


def notify(title, body, urgent):
    if os.name == "nt":  # a tray balloon needs no extra module; text travels in env vars to avoid quoting
        exe = shutil.which("pwsh") or shutil.which("powershell")
        script = ("Add-Type -AssemblyName System.Windows.Forms; $n = New-Object System.Windows.Forms.NotifyIcon; "
                  "$n.Icon = [System.Drawing.SystemIcons]::Information; $n.Visible = $true; "
                  "$n.ShowBalloonTip(10000, $env:TEAM_ALERT_TITLE, $env:TEAM_ALERT_BODY, 'Info'); "
                  "Start-Sleep -Seconds 10; $n.Dispose()")
        if exe:
            subprocess.Popen([exe, "-NoProfile", "-NonInteractive", "-Command", script],
                             env=dict(os.environ, TEAM_ALERT_TITLE=title, TEAM_ALERT_BODY=body), **QUIET)
    elif shutil.which("notify-send"):
        env = dict(os.environ, TEAM_NOTIFY_APP=N["app_name"] or NAME, TEAM_NOTIFY_SOUND_DIR=N["sound_dir"],
                   TEAM_NOTIFY_SOUND=N["sound_normal"], TEAM_NOTIFY_SOUND_URGENT=N["sound_urgent"])
        subprocess.Popen([os.path.join(HERE, "notify"), title, body, *(["urgent"] if urgent else [])], env=env, **QUIET)


def check(seen):
    try:
        team.dispatch()
    except (OSError, ValueError) as e:  # keep alerting when a queue pass fails
        print(f"queue: {e}", flush=True)
    review = []
    for tid, status, reason in team.wait_events(seen):
        notify(f"{NAME}: {tid} {status}", reason[:180], status != "done")
        print(f"\a{time.strftime('%H:%M')} {tid} {status}: {reason[:180]}", flush=True)
        if tid != "refill":  # proposals live in the queue file, not on a task page
            review.append(tid)
    if review:  # one page for everything that changed in this pass
        subprocess.run([sys.executable, os.path.join(HERE, "review_page"), *review, "--open"], **QUIET)


if __name__ == "__main__":
    seen = team.first_seen()
    print(f"watching {NAME} for tasks that need you", flush=True)
    check(seen)
    while "--once" not in sys.argv:
        time.sleep(10)
        check(seen)
